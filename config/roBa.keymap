#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt { retro-tap; };

&lt {
    tapping-term-ms = <0>;
    flavor = "hold-preferred";
    retro-tap;
};

&tog { toggle-mode = "off"; };

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        scroll {
            bindings = <&mo 5>;
            key-positions = <8 7>;
        };

        left_click {
            bindings = <&mkp LCLK>;
            key-positions = <18 19>;
        };

        right_click {
            bindings = <&mkp RCLK>;
            key-positions = <19 20>;
        };

        middle_click {
            bindings = <&mkp MCLK>;
            key-positions = <18 20>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        gui_tab: alt_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI &kp TAB>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp TAB &kp LEFT_GUI>;

            label = "ALT_TAB";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W         &kp E         &kp R      &kp T                                 &kp Y  &kp U  &kp I    &kp O          &kp P
&kp A      &kp S         &kp D         &kp F      &kp G       &kp MINUS      &kp COMMA  &kp H  &kp J  &kp K    &kp L          &lt 2 ENTER
&kp Z      &kp X         &kp C         &kp V      &kp B       &kp UNDER      &kp DOT    &kp N  &kp M  &kp ESC  &kp BACKSPACE  &gui_tab
&kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI  &kp SPACE  &kp LSHIFT  &kp TAB        &trans     &mo 1                                 &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        SYMBOLS {
            bindings = <
&kp GRAVE        &kp LESS_THAN  &kp GREATER_THAN  &kp MINUS          &kp PIPE                           &kp CARET  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp DOLLAR    &kp BACKSLASH
&kp EXCLAMATION  &kp ASTRK      &kp SLASH         &kp EQUAL          &kp AMPERSAND  &trans      &trans  &kp HASH   &kp LPAR        &kp RPAR         &kp SEMI      &kp DOUBLE_QUOTES
&kp TILDE        &kp PLUS       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PERCENT    &trans      &trans  &kp AT     &kp COLON       &trans           &kp QUESTION  &kp SINGLE_QUOTE
&trans           &trans         &trans            &trans             &trans         &trans      &trans  &trans                                                    &trans
            >;
        };

        ARROW+FUNCTION {
            bindings = <
&kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans  &trans                                   &kp F1    &kp F2    &kp F3  &kp F4     &kp F5
&kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp N0  &trans   &kp C_VOL_UP           &trans   &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp F9  &kp F10  &kp C_VOLUME_DOWN      &kp F11  &kp F12   &kp F13   &trans  &trans     &trans
&kp F6        &kp F7        &kp F8        &trans  &trans   &trans                 &trans   &trans                                 &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MODS {
            bindings = <
&trans       &trans            &trans          &trans          &trans                      &trans       &trans          &trans          &trans            &trans
&mt LCTRL A  &mt LEFT_SHIFT S  &mt LEFT_ALT D  &mt LEFT_GUI F  &trans  &trans      &trans  &trans       &mt LEFT_GUI J  &mt LEFT_ALT K  &mt LEFT_SHIFT L  &mt LCTRL SQT
&trans       &trans            &trans          &trans          &trans  &trans      &trans  &trans       &trans          &trans          &trans            &trans
&trans       &trans            &trans          &trans          &trans  &trans      &trans  &lt 1 SPACE                                                    &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans     &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK  &tog 4
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans     &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                   &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
