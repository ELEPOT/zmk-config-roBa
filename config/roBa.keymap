#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt { retro-tap; };

&lt {
    tapping-term-ms = <0>;
    flavor = "hold-preferred";
    retro-tap;
};

&tog { toggle-mode = "off"; };

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        scroll {
            bindings = <&mo 5>;
            key-positions = <8 7>;
        };

        left_click {
            bindings = <&mkp LCLK>;
            key-positions = <18 19>;
        };

        right_click {
            bindings = <&mkp RCLK>;
            key-positions = <19 20>;
        };

        middle_click {
            bindings = <&mkp MCLK>;
            key-positions = <18 20>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W        &kp E           &kp R      &kp T                      &kp Y            &kp U  &kp I      &kp O    &kp P
&kp A      &kp S        &kp D           &kp F      &kp G  &trans      &trans  &kp H            &kp J  &kp K      &kp L    &kp SQT
&kp Z      &kp X        &kp C           &kp V      &kp B  &trans      &trans  &kp N            &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LCTRL  &kp LG(TAB)  &kp LEFT_SHIFT  &kp SPACE  &mo 3  &mo 2       &mo 2   &lt 1 BACKSPACE                             &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        EXTENSION {
            bindings = <
&kp ESC         &kp GRAVE       &kp TAB           &trans    &trans                         &trans         &kp MINUS  &kp EQUAL          &kp ENTER        &kp DELETE
&kp N1          &kp N2          &kp N3            &kp N4    &kp N5     &trans      &trans  &kp N6         &kp N7     &kp N8             &kp N9           &kp N0
&kp LEFT_SHIFT  &kp LEFT_BRACE  &kp LEFT_BRACKET  &kp LPAR  &kp COLON  &trans      &trans  &kp SEMICOLON  &kp RPAR   &kp RIGHT_BRACKET  &kp RIGHT_BRACE  &kp BACKSLASH
&trans          &trans          &trans            &trans    &trans     &trans      &trans  &trans                                                        &trans
            >;
        };

        ARROW+FUNCTION {
            bindings = <
&kp KP_NUMBER_7  &kp KP_N8           &kp KP_N9            &trans  &trans                      &kp F1    &kp F2    &kp F3  &kp F4     &kp F5
&kp KP_NUMBER_4  &kp KP_N5           &kp KP_N6            &trans  &trans  &trans      &trans  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans
&kp KP_N1        &kp KP_N2           &kp KP_N3            &trans  &trans  &trans      &kp F6  &kp F7    &kp F8    &kp F9  &kp F10    &kp F11
&trans           &mt LEFT_GUI KP_N0  &mt LEFT_ALT KP_DOT  &trans  &trans  &trans      &trans  &trans                                 &kp F12
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MODS {
            bindings = <
&trans       &trans            &trans          &trans          &trans                      &trans       &trans          &trans          &trans            &trans
&mt LCTRL A  &mt LEFT_SHIFT S  &mt LEFT_ALT D  &mt LEFT_GUI F  &trans  &trans      &trans  &trans       &mt LEFT_GUI J  &mt LEFT_ALT K  &mt LEFT_SHIFT L  &mt LCTRL SQT
&trans       &trans            &trans          &trans          &trans  &trans      &trans  &trans       &trans          &trans          &trans            &trans
&trans       &trans            &trans          &trans          &trans  &trans      &trans  &lt 1 SPACE                                                    &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans     &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK  &tog 4
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans     &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                   &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
