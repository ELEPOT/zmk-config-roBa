#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt { retro-tap; };

&lt {
    tapping-term-ms = <0>;
    flavor = "hold-preferred";
    retro-tap;
};

&tog { toggle-mode = "off"; };

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        scroll {
            bindings = <&mo 5>;
            key-positions = <7 8>;
        };

        left_click {
            bindings = <&mkp LCLK>;
            key-positions = <18 19>;
        };

        right_click {
            bindings = <&mkp RCLK>;
            key-positions = <19 20>;
        };

        middle_click {
            bindings = <&mkp MCLK>;
            key-positions = <18 20>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        gui_tab: alt_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI &kp TAB>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp TAB &kp LEFT_GUI>;

            label = "ALT_TAB";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W         &kp E         &kp R      &kp T                                 &kp Y  &kp U  &kp I    &kp O          &kp P
&kp A      &kp S         &kp D         &kp F      &kp G       &kp MINUS      &kp COMMA  &kp H  &kp J  &kp K    &kp L          &kp ENTER
&kp Z      &kp X         &kp C         &kp V      &kp B       &kp UNDER      &kp DOT    &kp N  &kp M  &kp ESC  &kp BACKSPACE  &kp TAB
&kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI  &kp SPACE  &kp LSHIFT  &mo 3          &mo 2      &mo 1                                 &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        SYMBOLS {
            bindings = <
&kp GRAVE        &kp LESS_THAN  &kp GREATER_THAN  &kp MINUS          &kp PIPE                           &kp CARET  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp DOLLAR    &kp BACKSLASH
&kp EXCLAMATION  &kp ASTRK      &kp SLASH         &kp EQUAL          &kp AMPERSAND  &trans      &trans  &kp HASH   &kp LPAR        &kp RPAR         &kp SEMI      &kp DOUBLE_QUOTES
&kp TILDE        &kp PLUS       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PERCENT    &trans      &trans  &kp AT     &kp COLON       &trans           &kp QUESTION  &kp SINGLE_QUOTE
&trans           &trans         &trans            &trans             &trans         &trans      &trans  &trans                                                    &trans
            >;
        };

        ARROW+NUMPAD {
            bindings = <
&kp KP_N7        &kp KP_N8  &kp KP_N9  &kp KP_MINUS  &kp KP_PLUS                          &kp KP_NUMLOCK  &kp PRINTSCREEN  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans
&kp KP_NUMBER_4  &kp KP_N5  &kp KP_N6  &kp KP_N0     &kp KP_MULTIPLY  &trans      &trans  &kp LEFT        &kp DOWN         &kp UP             &kp RIGHT        &trans
&kp KP_N1        &kp KP_N2  &kp KP_N3  &kp KP_DOT    &kp KP_DIVIDE    &trans      &trans  &trans          &trans           &trans             &trans           &trans
&trans           &trans     &trans     &trans        &trans           &trans      &trans  &trans                                                               &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        FUNCTIONS+NUMROW {
            bindings = <
&kp F1  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans   &kp F12
&kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &trans      &trans  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &trans      &trans  &kp N6  &kp N7  &kp N8  &kp N9   &kp N0
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                           &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
